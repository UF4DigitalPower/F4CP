QScrollArea#AdpTrainingPage,
QWidget#adpTrainingScrollWidget {
    background-color: transparent;
    border: none;
}

QWidget#AdpCaptureCard,
QWidget#AdpActionCard,
QWidget#AdpMonitorCard {
    background-color: transparent;
    border: 1px solid rgba(128, 128, 128, 70);
    border-radius: 8px;
}

QWidget#AdpMonitorCard QTextEdit {
    background-color: transparent;
    border: 1px solid rgba(128, 128, 128, 70);
    min-height: 180px;
}
